{
  "dry_run": true,
  "status": "review_required_not_deployed",
  "api": "https://rest.runpod.io/v1",
  "template": {
    "method": "POST",
    "path": "/templates",
    "body": {
      "name": "openmontage-staging",
      "imageName": "ghcr.io/example/openmontage@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "category": "CPU",
      "isServerless": true,
      "isPublic": false,
      "containerDiskInGb": 20,
      "env": {
        "OPENMONTAGE_ROOT": "/opt/openmontage",
        "WORK_ROOT": "/tmp/openmontage",
        "COMPOSER_BROWSER_EXECUTABLE": "/usr/bin/chromium",
        "REMOTION_CONCURRENCY": "1",
        "STORAGE_BACKEND": "s3",
        "S3_BUCKET": "example-bucket",
        "S3_PREFIX": "openmontage",
        "S3_ENDPOINT_URL": "",
        "AWS_DEFAULT_REGION": "us-east-1"
      }
    }
  },
  "endpoint": {
    "method": "POST",
    "path": "/endpoints",
    "body": {
      "name": "openmontage-staging",
      "templateId": "<CREATED_TEMPLATE_ID>",
      "computeType": "CPU",
      "workersMin": 0,
      "workersMax": 1,
      "idleTimeout": 5,
      "executionTimeoutMs": 1200000,
      "scalerType": "QUEUE_DELAY",
      "scalerValue": 4,
      "cpuFlavorIds": [
        "example-confirm-in-console"
      ],
      "vcpuCount": 4
    }
  },
  "application_concurrency": 1,
  "storage_profile": "generic_s3",
  "required_secrets": [
    "RUNPOD_API_KEY",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY"
  ],
  "release_gates": [
    "unit tests",
    "container supplied-asset render",
    "SRE review",
    "verify persistence and input/output transfer",
    "confirm compute availability and pricing"
  ],
  "rollback": "Restore the previous verified image digest on the endpoint template; retain previous plan and smoke report.",
  "sources": [
    "https://docs.runpod.io/api-reference/templates/POST/templates",
    "https://docs.runpod.io/api-reference/endpoints/POST/endpoints",
    "https://docs.runpod.io/storage/network-volumes",
    "https://docs.runpod.io/storage/s3-api"
  ]
}
