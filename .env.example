# Runtime configuration; copy locally to .env, never commit credentials.
OPENMONTAGE_ROOT=/opt/openmontage
WORK_ROOT=/tmp/openmontage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/openmontage
INPUT_ROOT=/inputs
COMPOSER_BROWSER_EXECUTABLE=/usr/bin/chromium
REMOTION_CONCURRENCY=1
# Production: use generic S3, or attach a network volume and set
# STORAGE_BACKEND=local LOCAL_STORAGE_ROOT=/runpod-volume/openmontage.
# Never use the ephemeral /data default for production persistence.
REQUIRE_NETWORK_VOLUME=0
S3_BUCKET=
S3_PREFIX=openmontage
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed by deployment tooling, never baked into image.
RUNPOD_API_KEY=
